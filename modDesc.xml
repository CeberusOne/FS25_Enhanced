<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- FS25 Enhanced — descVersion must match game (log: ModDesc Version 113). -->
<modDesc descVersion="113">
    <author>CeberusOne</author>
    <version>0.4.2.7</version>
    <title>
        <en>FS25 Enhanced</en>
        <de>FS25 Enhanced</de>
    </title>
    <description>
        <en><![CDATA[Client-local adaptive graphics and performance governor for Farming Simulator 25.
Uses only documented Giants Engine / Settings APIs. No binary hooks.
v0.4.2.4: descVersion 113 for current FS25; install as mods/FS25_Enhanced/ folder (not nested zip).
Hover-help, Casual-Automatik Wave-1 Adaptive (default off), Expert Live Overlay, Pro HUD.
Soft-Apply off by default. No engine setters from GUI. Multiplayer: client-local only.]]></en>
        <de><![CDATA[Client-lokaler adaptiver Grafik- und Performance-Governor für Landwirtschafts-Simulator 25.
Nur dokumentierte Giants-Engine-/Settings-APIs. Keine Binary-Hooks.
v0.4.2.4: descVersion 113 für aktuelles FS25; Installation als Ordner mods/FS25_Enhanced/ (keine verschachtelte Zip).
Hover-Hilfe, Casual-Automatik Wave-1 Adaptive (Standard aus), Expert Live-Overlay, Pro-HUD.
Soft-Apply standardmäßig aus. Keine Engine-Setter aus der GUI. Multiplayer: nur client-lokal.]]></de>
    </description>
    <iconFilename>icon.png</iconFilename>
    <multiplayer supported="true"/>
    <l10n filenamePrefix="l10n/l10n">
        <text name="FS25E_MOD_NAME">
            <en>FS25 Enhanced</en>
            <de>FS25 Enhanced</de>
        </text>
    </l10n>
    <specializations>
        <specialization name="enhancedLightsProbe" className="EnhancedLightsProbe" filename="scripts/Specializations/EnhancedLightsProbe.lua"/>
    </specializations>
    <placeableSpecializations>
        <specialization name="enhancedPlaceableLightsProbe" className="EnhancedPlaceableLightsProbe" filename="scripts/Placeables/EnhancedPlaceableLightsProbe.lua"/>
    </placeableSpecializations>
    <extraSourceFiles>

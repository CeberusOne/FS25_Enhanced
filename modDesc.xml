    <actions>
        <action name="FS25E_OPEN_SETTINGS" category="SYSTEM" ignoreComboMask="false" />
        <action name="FS25E_TOGGLE_LIVE_OVERLAY" category="SYSTEM" ignoreComboMask="false" />
        <action name="FS25E_LIVE_HINT" category="SYSTEM" ignoreComboMask="false" />
    </actions>
    <inputBinding>
        <actionBinding action="FS25E_OPEN_SETTINGS">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_f9" />
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_e" />
        </actionBinding>
        <actionBinding action="FS25E_TOGGLE_LIVE_OVERLAY">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_f9" />
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lshift KEY_f9" />
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_lshift KEY_e" />
        </actionBinding>
    </inputBinding>
</modDesc>
